# JWT 签名密钥（随机生成, 代码强制要求 >=32 字符）
JWT_SIGNING_KEY=82076f35de56e2833b90c14971852f90c920ee8f4e451254c8def979174c7d60
JWT_ISSUER=SakuraFilter
JWT_AUDIENCE=SakuraFilter.Web

# 压测期间关闭限流以隔离搜索引擎延迟
RATELIMIT_ENABLED=false

# typeahead 基数守卫阈值: distinct 数超过此值的字段视为"近唯一", 短路返回空
# (oem-no3 1249万 / engine-type 199万 超阈值被守卫; machine-model 158K 保留)
Typeahead__MaxCardinality=1000000
