+    public string Type { get; set; } = "";
+
+    // ========== Day 8.1: 分区 1 (Product Name 1, Product Name 2, MR.1, OEM 2, 上架) ==========
+    // WHY product_name_1 在主表: 规格"一个产品一个主名", 与 xref 的 product_name_1 区分
