+      { key: 'efficiency2', label: '效率 2', get: (p) => p.efficiency2 ?? '' },
+      { key: 'bypassPressure', label: '旁通压力', get: (p) => (p.bypassPressure !== undefined && p.bypassPressure !== null ? String(p.bypassPressure) : '') },
