+  it('IMAGE_DETAIL_SLOT_INVALID 映射到 "图片详情槽位无效..."', () => {
+    expect(ERROR_CODE_I18N['IMAGE_DETAIL_SLOT_INVALID']).toContain('图片详情槽位无效')
+  })
