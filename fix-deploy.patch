+    [Fact]
+    public void ParseSettings_Large_Values_Accepted()
+    {
+        // 覆盖: 大数值 (边界值) 应被接受 (int.TryParse 范围内)
+        var settings = new Dictionary<string, string?>
+        {
+            ["dead_letter.retention_days"] = "365",  // 1 年
+            ["dead_letter.cleanup_batch_size"] = "50000",
+        };
+
+        var s = DeadLetterCleanupClassifier.ParseSettings(settings);
+        s.RetentionDays.Should().Be(365);
+        s.BatchSize.Should().Be(50000);
+    }
+
+    [Fact]
+    public void ParseSettings_Ignores_Unrelated_Keys()
+    {
+        // 覆盖: 字典中含其他 key 不影响解析
+        var settings = new Dictionary<string, string?>
+        {
+            ["dead_letter.retention_enabled"] = "true",
+            ["dead_letter.retention_days"] = "21",
+            ["other.unrelated.key"] = "999",
+            ["etl_log.retention_days"] = "90",  // 不同前缀, 不应影响
+        };
+
+        var s = DeadLetterCleanupClassifier.ParseSettings(settings);
+        s.RetentionDays.Should().Be(21);
+        s.BatchSize.Should().Be(2000);  // 默认
+    }
+}
