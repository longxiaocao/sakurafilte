+  try {
+    // V24-F59: 剥离客户端 _uid 字段, 不提交后端
+    //   _uid 仅用于 v-for key, 后端 XrefInput/MachineAppInput 不识别此字段
+    const stripUid = (arr: any[]) => arr.map(({ _uid, ...rest }) => rest)
