+            if (slot < 2 || slot > 6) return Results.BadRequest(new { error = "详情图 slot 必须在 2-6 之间" });
+            if (!req.HasFormContentType) return Results.BadRequest(new { error = "需 multipart/form-data" });
+            var form = await req.ReadFormAsync(ct);
