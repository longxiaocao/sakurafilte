-
-    var batch = new List<ProductIndexDoc>(1000);
-    await foreach (var doc in query.AsAsyncEnumerable().WithCancellation(ct))
-    {
-        batch.Add(doc);
-        if (batch.Count >= 1000)
-        {
-            await search.IndexAsync(batch, ct);
-            batch.Clear();
-        }
-    }
-    if (batch.Count > 0) await search.IndexAsync(batch, ct);
-}
