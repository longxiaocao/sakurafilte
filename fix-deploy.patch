+const reindexing = ref(false)
+const lastReindex = ref<ReindexResult | null>(null)
+
+async function doReindexAll() {
+  // 二次确认: 全量重建会清空 Meilisearch 全部文档, 期间搜索不可用
+  try {
+    await ElMessageBox.confirm(
