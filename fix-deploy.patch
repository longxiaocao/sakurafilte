+/* Day 9: 全局样式 — Musk 风格极简 */
+/*   - 无阴影, 1px hairline 边框, 8px 网格, Inter 字体 */
+/* Day 10+ P5.3: 主题切换 (light/dark) — CSS 变量驱动 */
+@tailwind base;
+@tailwind components;
