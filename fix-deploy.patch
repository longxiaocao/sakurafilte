+using FluentAssertions;
+using SakuraFilter.Api.Services;
+using SakuraFilter.Search;
+using Xunit;
+
+namespace SakuraFilter.Api.Tests;
+
+/// <summary>
+/// v30-13: PerfAlertClassifier 纯函数单元测试
+///
