diff --git a/_tmp/src_master/sakurafilte-1e97a92/backend/src/SakuraFilter.Core/Entities/Product.cs b/_tmp/src_master/sakurafilte-1e97a92/backend/src/SakuraFilter.Core/Entities/Product.cs
