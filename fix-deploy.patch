+    await page
+      .locator('div.cursor-pointer')
+      .filter({ hasText: `sort:` })
+      .filter({ hasText: brandName })
+      .first()
+      .click()
+  } else {
+    await page.locator('div.cursor-pointer:has-text("sort:")').first().click()
+  }
+  await page.waitForSelector('.drag-handle', { timeout: 10000 })
+}
