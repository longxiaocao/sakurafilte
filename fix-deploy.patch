-   * WHY: 防止开放重定向漏洞(如 `/\evil.com` 被浏览器规范化为 `//evil.com`)
-   * HOW: 先用 new URL 规范化,再校验 hostname
-   */
-  export function isSafeRedirect(target: string): boolean {
