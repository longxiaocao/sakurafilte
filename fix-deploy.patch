+/// </summary>
+public class CursorHmacTests
+{
+    private const string Key = "test-cursor-hmac-key-must-be-32-chars-min-X7K9M2P5";
+    private const string PreviousKey = "previous-cursor-hmac-key-also-32-chars-min-Z8L0N3Q6";
