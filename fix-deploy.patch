+    /// <summary>ETL 当前任务已读取行数 (无活动任务时为 0) — 迁移自 /metrics 手动输出</summary>
+    public readonly Gauge EtlProgressRead = Prometheus.Metrics.CreateGauge(
+        "sakurafilter_etl_progress_read",
