+  //   打开抽屉前先 load, 避免空闪烁
+  //   Day 9.4: 切换产品时重置 cursor, 不然下一页的 cursor 是上个产品的
+  currentHistoryProductId.value = row.id
+  historyNextCursor.value = null
+  historyHasMore.value = false
+  historyOpen.value = true
