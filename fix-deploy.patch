diff --git a/_tmp/src_master/sakurafilte-1e97a92/backend/src/SakuraFilter.Api/Endpoints/AdminEtlEndpoints.cs b/_tmp/src_master/sakurafilte-1e97a92/backend/src/SakuraFilter.Api/Endpoints/AdminEtlEndpoints.cs
