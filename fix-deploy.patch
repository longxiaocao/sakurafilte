+# SakuraFilter Docker Build & Push
+#   构建 + 推送 backend/frontend 镜像到 GitHub Container Registry (ghcr.io)
+#   触发: master push + tag (v*)
+#   缓存: GitHub Actions cache (按 commit/branch 区分)
+#   多架构: amd64 + arm64 (匹配 dev/prod 部署场景)
+#
+#   注意: 不与 ci.yml 并行, 因为 docker build 需要 dotnet sdk 镜像 (~1.5GB)
+#     → 拆为独立 workflow, master push 后立即跑
+#
+#   设计要点:
+#     1) 多阶段构建: 已存在 Dockerfile, 直接 docker build
+#     2) cache-from type=gha: 利用 GH Actions 缓存层
+#     3) tags: latest + commit-sha + branch-name
+#     4) labels: org.opencontainers.image.* (符合 OCI 规范)
+
+name: docker
+
+on:
+  push:
+    branches: [master, main]
+    tags: ['v*']
+  pull_request:
+    branches: [master, main]
+  workflow_dispatch:
+
+# 避免同时多次构建: master 立即取消旧, PR 等完成
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: ${{ github.ref != 'refs/heads/master' && github.ref != 'refs/heads/main' }}
+
+env:
+  REGISTRY: ghcr.io
+  IMAGE_PREFIX: longxiaocao/sakurafilter
+  # 镜像构建时版本标签来源: tag > sha > branch
+  VERSION: ${{ github.ref_type == 'tag' && github.ref_name || github.sha }}
+
+jobs:
+  # ============================================================
+  # Job 1: Backend (ASP.NET 8 API) 镜像构建
+  # ============================================================
+  backend:
+    name: Backend Image
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    permissions:
+      contents: read
+      packages: write
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Set up Docker Buildx
+        uses: docker/setup-buildx-action@v3
+
+      - name: Log in to GHCR
+        if: github.event_name != 'pull_request'
+        uses: docker/login-action@v3
+        with:
+          registry: ${{ env.REGISTRY }}
+          username: ${{ github.actor }}
+          password: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Extract metadata (tags, labels)
+        id: meta
+        uses: docker/metadata-action@v5
+        with:
+          images: ${{ env.REGISTRY }}/${{ env.IMAGE_PREFIX }}-backend
+          tags: |
+            type=ref,event=branch
+            type=ref,event=pr
+            type=sha,prefix=
+            type=raw,value=${{ env.VERSION }}
+            type=raw,value=latest,enable={{is_default_branch}}
+          labels: |
+            org.opencontainers.image.title=SakuraFilter Backend
+            org.opencontainers.image.description=ASP.NET 8 滤清器产品管理 API
+            org.opencontainers.image.source=${{ github.server_url }}/${{ github.repository }}
