+            </div>
+            <div v-if="isExpanded(ep.path, ep.method)" class="ml-7 mt-2 text-xs space-y-2">
+              <div v-if="ep.params.length">
+                <div class="font-medium mb-1">Parameters:</div>
+                <table class="w-full text-xs">
