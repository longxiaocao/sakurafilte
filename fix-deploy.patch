+    /// V2: 签名从 IEnumerable&lt;long&gt; ids 改为 IEnumerable&lt;string&gt; mr1s (修复 S19)
+    /// WHY: V2 主键改为 mr_1 (字符串),删除按主键更准确,避免 id 映射错误
+    /// </summary>
+    Task DeleteAsync(IEnumerable<string> mr1s, CancellationToken ct = default);
+}
+
