+    {
+        // 覆盖: 部分 key 存在部分缺失, 存在的用解析值, 缺失的用默认值
+        //   场景: 运维只配置了 retention_days, batch_size 用默认
+        var settings = new Dictionary<string, string?>
+        {
+            ["dead_letter.retention_days"] = "14",
+            // batch_size 缺失
+        };
