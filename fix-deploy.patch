+    /// <summary>死信队列深度 (status=active 行数) — 迁移自 /metrics 手动输出</summary>
+    public readonly Gauge DeadLetterDepthLegacy = Prometheus.Metrics.CreateGauge(
+        "sakurafilter_dead_letter_depth",
