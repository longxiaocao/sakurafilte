diff --git a/_tmp/src_master/sakurafilte-1e97a92/backend/src/SakuraFilter.Api/Services/AdminProductImageService.cs b/_tmp/src_master/sakurafilte-1e97a92/backend/src/SakuraFilter.Api/Services/AdminProductImageService.cs
