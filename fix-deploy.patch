+/// - 解决:进程重启后 EtlProgress 单例丢失,无法回溯昨天 14:00 的 ETL 状态
+/// - 用途: 运维查"今天跑了哪些 ETL/成功失败/读入多少",Dashboard 直接 SELECT
+/// - 不存 recentErrors 数组 (单条 message 体量大,留 last_error 即可)
+/// </summary>
+public class EtlProgressLog
+{
