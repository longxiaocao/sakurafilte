# P1-2: 生产环境变量样例
#   复制: cp .env.prod.example .env.prod
#   必须修改: 所有标 [CHANGE-ME] 的字段
#
#   安全: 此文件 **不入版本控制** (见 .gitignore)
#        部署时通过密钥管理 (Vault / K8s Secret / 1Password CLI) 注入

# ===== 数据库 =====
POSTGRES_DB=sakurafilter
POSTGRES_USER=sakura
POSTGRES_PASSWORD=[CHANGE-ME]32+chars-strong-password

# ===== MeiliSearch =====
MEILI_MASTER_KEY=[CHANGE-ME]32+chars-master-key

# ===== MinIO =====
MINIO_ROOT_USER=[CHANGE-ME]minio-admin
MINIO_ROOT_PASSWORD=[CHANGE-ME]minio-strong-password

# ===== 对象存储选择（Cloudflare R2） =====
# 默认使用 minio；切换为 r2 时，填写 R2 S3 API 凭证。
# Endpoint 只填 host，不带 https://，例如 <account-id>.r2.cloudflarestorage.com。
# 正式图片域名建议使用自定义域名；未配置前 R2_PUBLIC_ENDPOINT 可留空。
STORAGE_PROVIDER=minio
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY_SECRET=
R2_BUCKET_NAME=sakurafilter-images-prod
R2_PUBLIC_ENDPOINT=

# ===== JWT (必须 >= 32 字符) =====
JWT_SIGNING_KEY=[CHANGE-ME]please-generate-with-openssl-rand-base64-48
JWT_ISSUER=sakurafilter-prod
JWT_AUDIENCE=sakurafilter-fe

# ===== 管理员初始 Token (开发模式, 生产应改为 SSO) =====
ADMIN_DEV_TOKEN=[CHANGE-ME]64+chars-rotated-quarterly

# ===== 首次启动默认用户密码 (compose api 服务引用, 必须配置) =====
#   Users 表为空时自动创建 admin/operator; 漏配会以空值传入 → 默认用户创建失败,
#   只能依赖 ADMIN_DEV_TOKEN 或手动 SQL, 文档登录流程不可用。
INITIAL_ADMIN_PASSWORD=[CHANGE-ME]initial-admin-password
INITIAL_OPERATOR_PASSWORD=[CHANGE-ME]initial-operator-password

# ===== Grafana =====
GRAFANA_USER=admin
GRAFANA_PASSWORD=[CHANGE-ME]change-on-first-login

# ===== 公开站点构建变量（非敏感，会写入浏览器构建产物） =====
# 正式业务文案可留空；如包含换行，请使用部署平台支持的多行环境变量格式。
VITE_INQUIRY_EMAIL=
VITE_PUBLIC_ABOUT_TEXT=
VITE_PUBLIC_NEWS_TEXT=
VITE_PUBLIC_CONTACT_TEXT=
